  "method": "Read each original font once as bytes; SHA256 and every field are derived from that same byte snapshot with Python struct big-endian SFNT parsing. Original font files are read-only; no Word call or font installation.",
  "scope": "Regular faces only: Times New Roman, Arial, Courier New. Luminari is excluded from the primary experiment.",
  "units": {
    "upem": "font design units per em",
    "hhea": "font design units",
    "H.hmtxAdvance": "font design units",
    "OS2 sizes and offsets": "signed font design units",
    "OS2RatiosEm": "raw field / upem"
  },
  "fieldSources": {
    "tableFileOffsets": "SFNT table directory: table offset at record + 8; offsets are absolute within the file.",
    "names": "name table IDs 1/2/4/6; prefer Windows English-US Unicode records, with the chosen IDs retained per field.",
    "upem": "head.unitsPerEm, uint16 at table offset + 18.",
    "hhea": "ascender/descender/lineGap are int16 at +4/+6/+8; numberOfHMetrics is uint16 at +34.",
    "H.glyphId": "Resolve U+0048 through the selected Unicode cmap subtable. For format 4, apply idRangeOffset and nonzero glyph idDelta modulo 65536; for format 12, use startGlyphId + codepoint - startCharCode.",
    "H.hmtxAdvance": "hmtx uint16 advanceWidth at 4 * min(glyphId, hhea.numberOfHMetrics - 1); exact file byte offset is retained.",
    "OS2.version": "OS/2 uint16 at table offset + 0.",
